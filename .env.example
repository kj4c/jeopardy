# Random string used to sign board login cookies. Set a long random value in production.
SESSION_SECRET=change-me
# Where the SQLite database and uploaded images are stored. Mount a persistent volume here in production.
DATA_DIR=./data
PORT=3000
# Turns on /admin, which lists every room and board and lets you download backups. Leave unset to keep it off.
ADMIN_PASSWORD=
# Set to a backup file name from /admin and restart to roll the database back to it. Remove afterwards.
RESTORE_BACKUP=
